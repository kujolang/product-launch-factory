{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kujolang/product-launch-factory/blob/main/schemas/launch-brief.json",
  "title": "Product Launch Factory brief",
  "type": "object",
  "properties": {
    "schema": {
      "const": "kujo.product-launch.brief/v1"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "audience": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "voice": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "constraints": {
      "type": "array",
      "maxItems": 15,
      "items": {
        "type": "string",
        "maxLength": 1500
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,39}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        },
        "required": [
          "id",
          "path",
          "url"
        ],
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "software-export",
            "webops-package"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "path"
      ],
      "additionalProperties": false
    },
    "visuals": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,39}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "rights": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "path",
          "url",
          "description",
          "rights"
        ],
        "additionalProperties": false
      }
    },
    "video": {
      "type": "object",
      "properties": {
        "duration": {
          "type": "number",
          "minimum": 12,
          "maximum": 60,
          "description": "Silent video length, or maximum visual budget for narration. Narrated visuals fit the measured speech plus a short ending hold without trimming words."
        },
        "narration": {
          "type": "object"
        },
        "cta": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      },
      "required": [
        "duration"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "title",
    "audience",
    "objective",
    "voice",
    "constraints",
    "sources",
    "evidence",
    "video"
  ],
  "additionalProperties": false
}
