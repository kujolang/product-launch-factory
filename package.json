{
  "name": "@kujolang/product-launch-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=26.12.1 <27"
  },
  "scripts": {
    "setup": "python3 scripts/setup.py",
    "login": "node scripts/login.mjs",
    "doctor": "python3 src/launch.py doctor",
    "factory": "python3 src/launch.py",
    "start": "python3 src/launch.py serve",
    "test": "python3 -m unittest discover -s tests -v && node --test tests/video.test.mjs",
    "verify": "npm test && python3 scripts/check_docs.py",
    "demo": "python3 src/launch.py demo"
  },
  "dependencies": {
    "@openai/codex": "0.144.4",
    "playwright": "1.61.1"
  }
}
